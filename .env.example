# SentinelX Environment Configuration
# Copy to .env and configure for local or production use

# API Server
PORT=8000
HOST=0.0.0.0
SECRET_KEY=sentinelx_zero_trust_demo_secret_key_change_in_production

# Database (SQLite by default for instant local execution, or PostgreSQL URL)
DATABASE_URL=sqlite:///./sentinelx.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelx

# PayPal Sandbox Credentials (PayPal AI Hackathon)
# Leave empty for sandbox simulated mode, or provide real PayPal Developer Sandbox keys
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Security Gateway Operating Flags
SHADOW_MODE=false
GLOBAL_FREEZE=false

# Optional LLM Provider (Gemini / OpenAI API Key for AI Security Copilot & Semantic Explanations)
GEMINI_API_KEY=
OPENAI_API_KEY=

